{
  "name": "sigma-shopify-ai-blog",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "setup": "node scripts/setup.mjs",
    "check:shopify": "node --env-file=.env.local --import tsx scripts/cli.ts check",
    "preview:article": "node --env-file=.env.local --import tsx scripts/cli.ts preview",
    "publish:article": "node --env-file=.env.local --import tsx scripts/cli.ts publish",
    "trigger": "node --env-file=.env.local scripts/trigger.mjs"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
