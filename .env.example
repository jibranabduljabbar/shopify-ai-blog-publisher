# Run npm run setup to create .env.local with a random CRON_SECRET.
# Never commit .env.local. Add these values separately in Vercel Production settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SHOPIFY_STORE_DOMAIN=sigma-ai-blog.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional alternative for an existing app with a suitable long-lived token:
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Auto-discovered by handle when the ID is blank:
SHOPIFY_BLOG_ID=
SHOPIFY_BLOG_HANDLE=build-with-ai
BLOG_AUTHOR=Sigma Web Hub
CRON_SECRET=
# true publishes immediately; false creates drafts.
PUBLISH_ARTICLES=true
# Set false to pause publishing without removing the Vercel schedule.
AUTOMATION_ENABLED=true
# 1 = weekly, 2 = every other week, anchored to this Monday (UTC).
PUBLISH_EVERY_WEEKS=1
SCHEDULE_ANCHOR=2026-09-28
